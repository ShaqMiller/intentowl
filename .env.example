# ---------------------------------------------------------------------------
# IntentOwl — copy to .env and fill in. Both apps validate this with Zod at
# boot (apps/*/src/env.ts) and crash loudly if anything required is missing.
# ---------------------------------------------------------------------------

# Supabase pooled connection string (Session mode, port 5432 for migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intentowl

# --- M2: classification -----------------------------------------------------
ANTHROPIC_API_KEY=
# Only needed if your key is org-scoped rather than workspace-scoped.
# Console -> Settings -> Workspaces. Looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# --- M1: ingestion ----------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=intentowl/0.1 (by /u/your-reddit-username)

# --- M6: additional sources -------------------------------------------------
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# --- M3: digest delivery ----------------------------------------------------
# The From address must be on a domain verified in Resend. Use a sending
# subdomain (send.example.com) so its SPF cannot collide with the root domain's.
# Left unset, the code falls back to Resend's shared onboarding@resend.dev,
# which can only deliver to your own Resend account address — fine for a smoke
# test, useless for a customer.
DIGEST_FROM="IntentOwl <digests@send.example.com>"
# Where replies land. Required in practice: the sending subdomain has no inbox,
# so without this every reply to a digest is lost.
DIGEST_REPLY_TO=hello@example.com
RESEND_API_KEY=

# --- M5: billing ------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=
# Payment Link URLs from the Stripe dashboard. The landing page hides the
# buttons until these are set, so the site is safe to deploy before they exist.
STRIPE_LINK_MONTHLY=
STRIPE_LINK_ANNUAL=
# Where the thank-you page sends people to describe their product.
ONBOARDING_FORM_URL=

# --- M6: ops ----------------------------------------------------------------
OPS_SLACK_WEBHOOK_URL=

# Public base URL of apps/web, used for digest feedback links.
APP_URL=http://localhost:3000

# --- worker runtime ---------------------------------------------------------
LOG_LEVEL=info
PORT=8080

# --- M6: feedback links -----------------------------------------------------
# HMAC key signing the thumbs-up/down links in the digest. Any long random
# string; the worker and the web app must agree. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_SECRET=

# --- M7: authentication -----------------------------------------------------
# Supabase project Settings -> API. Only these two are needed: "sign out
# everywhere" runs on the user's own session, so no service-role key is used.
# Both are safe to expose to the browser; row-level security is the real guard.
#
# IMPORTANT: turn ON email confirmations in Authentication -> Providers -> Email.
# A customer account is claimed by proving control of the email address the
# digest already goes to; with confirmations off, anyone who knows a customer's
# address could claim their account.
SUPABASE_URL=
SUPABASE_ANON_KEY=
