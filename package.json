{
  "name": "intentowl",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @intentowl/db db:generate",
    "db:migrate": "pnpm --filter @intentowl/db db:migrate",
    "db:studio": "pnpm --filter @intentowl/db db:studio",
    "cli": "pnpm --filter @intentowl/worker cli",
    "test": "turbo run test",
    "eval": "pnpm --filter @intentowl/core eval"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "@types/node": "22.20.1",
    "vitest": "5.0.0"
  }
}
